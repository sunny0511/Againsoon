{
  "expo": {
    "name": "Againsoon",
    "slug": "againsoon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "againsoon",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.againsoon.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Againsoon",
        "NSLocationWhenInUseUsageDescription": "Againsoon can share how far you are in the hour before a confirmed meet, so you and your person can see the distance between you.",
        "NSPhotoLibraryUsageDescription": "Againsoon can attach a photo to a memory of a date you shared."
      }
    },
    "android": {
      "package": "com.againsoon.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#161018",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#161018"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Againsoon can share how far you are in the hour before a confirmed meet, so you and your person can see the distance between you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Againsoon can attach a photo to a memory of a date you shared."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

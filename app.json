{
  "expo": {
    "name": "Againsoon",
    "slug": "againsoon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "againsoon",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#161018"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#161018"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.againsoon.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Againsoon",
        "NSLocationWhenInUseUsageDescription": "Againsoon can share how far you are in the hour before a confirmed meet, so you and your person can see the distance between you.",
        "NSPhotoLibraryUsageDescription": "Againsoon can attach a photo to a memory of a date you shared."
      }
    },
    "android": {
      "package": "com.againsoon.app",
      "versionCode": 1,
      "label": "Againsoon",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#161018",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#161018"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Againsoon can share how far you are in the hour before a confirmed meet, so you and your person can see the distance between you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Againsoon can attach a photo to a memory of a date you shared.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
